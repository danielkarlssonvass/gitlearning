<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Screen flow launched from an Opportunity record page. Lets the user update the Type picklist field. Appends or removes " - Upsell/Renewal" from the name based on the transition to/from "New Customer".</description>
    <interviewLabel>Opportunity Update Type {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Update Type</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <dynamicChoiceSets>
        <name>PicklistChoiceSet_Type</name>
        <dataType>Picklist</dataType>
        <displayField>label</displayField>
        <picklistField>Type</picklistField>
        <picklistObject>Opportunity</picklistObject>
    </dynamicChoiceSets>
    <formulas>
        <name>Formula_AppendedName</name>
        <dataType>String</dataType>
        <expression>{!Get_Opportunity.Name} &amp; " - Upsell/Renewal"</expression>
    </formulas>
    <formulas>
        <name>Formula_RemovedName</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!Get_Opportunity.Name}, " - Upsell/Renewal", "")</expression>
    </formulas>
    <recordLookups>
        <name>Get_Opportunity</name>
        <label>Get Opportunity</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_UpdateType</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Screen_UpdateType</name>
        <label>Update Type</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Decision_TypeChanged</targetReference>
        </connector>
        <fields>
            <name>Display_OpportunityName</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Opportunity:&lt;/b&gt; {!Get_Opportunity.Name}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Input_Type</name>
            <choiceReferences>PicklistChoiceSet_Type</choiceReferences>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>Get_Opportunity.Type</elementReference>
            </defaultValue>
            <fieldText>Type</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Success</name>
        <label>Success</label>
        <locationX>88</locationX>
        <locationY>840</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_SuccessMessage</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Opportunity Type updated successfully.&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_NoChange</name>
        <label>No Changes Made</label>
        <locationX>264</locationX>
        <locationY>480</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_NoChangeMessage</name>
            <fieldText>&lt;p&gt;No changes were made. The Type remains &lt;b&gt;{!Get_Opportunity.Type}&lt;/b&gt;.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <decisions>
        <name>Decision_TypeChanged</name>
        <label>Type Changed?</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <defaultConnector>
            <targetReference>Screen_NoChange</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Change</defaultConnectorLabel>
        <rules>
            <name>Outcome_TypeWasChanged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Input_Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Opportunity.Type</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Decision_NameLogic</targetReference>
            </connector>
            <label>Type Was Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_NameLogic</name>
        <label>Name Logic</label>
        <locationX>88</locationX>
        <locationY>480</locationY>
        <defaultConnector>
            <targetReference>Update_TypeOnly</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Name Change</defaultConnectorLabel>
        <rules>
            <name>Outcome_WasNewCustomer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New Customer</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_AppendNameAndType</targetReference>
            </connector>
            <label>Was New Customer</label>
        </rules>
        <rules>
            <name>Outcome_NowNewCustomer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Input_Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New Customer</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_RemoveNameAndType</targetReference>
            </connector>
            <label>Now New Customer</label>
        </rules>
    </decisions>
    <recordUpdates>
        <name>Update_AppendNameAndType</name>
        <label>Update Type and Append Upsell to Name</label>
        <locationX>0</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Screen_Success</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Type</field>
            <value>
                <elementReference>Input_Type</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Formula_AppendedName</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_RemoveNameAndType</name>
        <label>Update Type and Remove Upsell from Name</label>
        <locationX>88</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Screen_Success</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Type</field>
            <value>
                <elementReference>Input_Type</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Formula_RemovedName</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_TypeOnly</name>
        <label>Update Type Only</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Screen_Success</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Type</field>
            <value>
                <elementReference>Input_Type</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
</Flow>
