<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Screen flow launched from an Opportunity record page. Lets the user update the Type picklist field. Appends or removes " - Upsell/Renewal" from the Opportunity name based on whether the type changes to or from "New Customer".</description>
    <interviewLabel>Opportunity Update Type {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Update Type</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity</targetReference>
        </connector>
    </start>
    <status>Active</status>

    <!-- ═══════════════════════════════════════
         VARIABLES
    ═══════════════════════════════════════ -->

    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <name>var_NewName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

    <!-- ═══════════════════════════════════════
         DYNAMIC CHOICE SETS
    ═══════════════════════════════════════ -->

    <dynamicChoiceSets>
        <name>PicklistChoiceSet_Type</name>
        <dataType>Picklist</dataType>
        <displayField>label</displayField>
        <picklistField>Type</picklistField>
        <picklistObject>Opportunity</picklistObject>
    </dynamicChoiceSets>

    <!-- ═══════════════════════════════════════
         FORMULAS
    ═══════════════════════════════════════ -->

    <formulas>
        <name>Formula_AppendUpsell</name>
        <dataType>String</dataType>
        <expression>{!Get_Opportunity.Name} &amp; ' - Upsell/Renewal'</expression>
    </formulas>

    <formulas>
        <name>Formula_RemoveUpsell</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!Get_Opportunity.Name}, ' - Upsell/Renewal', '')</expression>
    </formulas>

    <!-- ═══════════════════════════════════════
         GET RECORDS
    ═══════════════════════════════════════ -->

    <recordLookups>
        <name>Get_Opportunity</name>
        <label>Get Opportunity</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_UpdateType</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <!-- ═══════════════════════════════════════
         SCREENS
    ═══════════════════════════════════════ -->

    <screens>
        <name>Screen_UpdateType</name>
        <label>Update Type</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Decision_TypeChanged</targetReference>
        </connector>
        <fields>
            <name>Display_OpportunityName</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Opportunity:&lt;/b&gt; {!Get_Opportunity.Name}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Input_Type</name>
            <choiceReferences>PicklistChoiceSet_Type</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>Get_Opportunity.Type</defaultSelectedChoiceReference>
            <fieldText>Type</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <screens>
        <name>Screen_Success</name>
        <label>Success</label>
        <locationX>88</locationX>
        <locationY>840</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_SuccessMessage</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Opportunity updated successfully.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Type is now: &lt;b&gt;{!Input_Type}&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <screens>
        <name>Screen_NoChange</name>
        <label>No Changes Made</label>
        <locationX>308</locationX>
        <locationY>480</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_NoChangeMessage</name>
            <fieldText>&lt;p&gt;No changes were made. The Type remains &lt;b&gt;{!Get_Opportunity.Type}&lt;/b&gt;.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <!-- ═══════════════════════════════════════
         DECISIONS
    ═══════════════════════════════════════ -->

    <decisions>
        <name>Decision_TypeChanged</name>
        <label>Type Changed?</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <defaultConnector>
            <targetReference>Screen_NoChange</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Change</defaultConnectorLabel>
        <rules>
            <name>Outcome_TypeWasChanged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Input_Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Opportunity.Type</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Decision_NameUpdate</targetReference>
            </connector>
            <label>Type Was Changed</label>
        </rules>
    </decisions>

    <decisions>
        <name>Decision_NameUpdate</name>
        <label>Name Update Needed?</label>
        <locationX>88</locationX>
        <locationY>480</locationY>
        <defaultConnector>
            <targetReference>Assignment_KeepName</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Name Change</defaultConnectorLabel>
        <rules>
            <name>Outcome_WasNewCustomer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New Customer</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Input_Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>New Customer</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_AppendUpsell</targetReference>
            </connector>
            <label>Was New Customer → Append Upsell/Renewal</label>
        </rules>
        <rules>
            <name>Outcome_NowNewCustomer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>New Customer</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Input_Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New Customer</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_RemoveUpsell</targetReference>
            </connector>
            <label>Now New Customer → Remove Upsell/Renewal</label>
        </rules>
    </decisions>

    <!-- ═══════════════════════════════════════
         ASSIGNMENTS
    ═══════════════════════════════════════ -->

    <assignments>
        <name>Assignment_AppendUpsell</name>
        <label>Append Upsell/Renewal to Name</label>
        <locationX>0</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>var_NewName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Formula_AppendUpsell</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Opportunity</targetReference>
        </connector>
    </assignments>

    <assignments>
        <name>Assignment_RemoveUpsell</name>
        <label>Remove Upsell/Renewal from Name</label>
        <locationX>88</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>var_NewName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Formula_RemoveUpsell</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Opportunity</targetReference>
        </connector>
    </assignments>

    <assignments>
        <name>Assignment_KeepName</name>
        <label>Keep Existing Name</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>var_NewName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Opportunity.Name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Opportunity</targetReference>
        </connector>
    </assignments>

    <!-- ═══════════════════════════════════════
         RECORD UPDATES
    ═══════════════════════════════════════ -->

    <recordUpdates>
        <name>Update_Opportunity</name>
        <label>Update Opportunity</label>
        <locationX>88</locationX>
        <locationY>720</locationY>
        <connector>
            <targetReference>Screen_Success</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>var_NewName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <elementReference>Input_Type</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>

</Flow>
